# ── Airflow Core ──────────────────────────────────────────────────────────────
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Generate JWT secret: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=

# ── Database (existing PostgreSQL cluster) ────────────────────────────────
# DB_HOST=myserver.postgres.database.azure.com
# DB_PASS=mypassword
# DB_USER=airflow       # optional, defaults to 'airflow'
# Pulumi creates the 'airflow' database and injects SQL_ALCHEMY_CONN automatically.
# For local dev, these are set by docker-compose.override.yml

# ── Celery broker (Redis / ElastiCache in prod) ───────────────────────────
# AIRFLOW__CELERY__BROKER_URL=redis://:@redis:6379/0
# (set by docker-compose.override.yml locally)

# ── Admin user (created on first init) ───────────────────────────────────────
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# ── Airflow UID ───────────────────────────────────────────────────────────────
AIRFLOW_UID=50000

# ── Data connections ──────────────────────────────────────────────────────────
# Trino connection — used by dbt and any direct SQL queries.
# conn_id: DWE  |  Connection type: Trino
#
# Local Trino (no auth, plain HTTP):
# AIRFLOW_CONN_DWE=trino://user@localhost:8080/hive
#
# Production Trino (HTTPS required — TrinoAuthError without it):
# AIRFLOW_CONN_DWE=trino://user:password@host:443/hive?http_scheme=https

# PyIceberg catalog connection — used for direct Parquet writes (bulk loads).
# conn_id: ICEBERG  |  Connection type: Generic  |  all properties in Extra JSON
#
# Azure ADLS Gen2:
#   {
#     "type":              "rest",
#     "uri":               "<CATALOG_URL>/iceberg",
#     "token":             "<NESSIE_TOKEN>",
#     "adls.account-name": "<AZURE_STORAGE_ACCOUNT>",
#     "adls.account-key":  "<AZURE_STORAGE_KEY>"
#   }
#
# MinIO / S3-compatible:
#   {
#     "type":                 "rest",
#     "uri":                  "<CATALOG_URL>/iceberg",
#     "token":                "<NESSIE_TOKEN>",
#     "s3.endpoint":          "http://minio:9000",
#     "s3.access-key-id":     "...",
#     "s3.secret-access-key": "..."
#   }
